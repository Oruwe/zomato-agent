# ---- environment -----------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- safety (defaults are deliberately restrictive) ------------------------
# DRY_RUN=true simulates checkout and never spends money. Flip to false only
# after you have watched a full dry run and trust the policy settings below.
DRY_RUN=true
ALLOW_AUTONOMOUS_CHECKOUT=false

# ---- LLM -------------------------------------------------------------------
# Optional. With no key the agent uses the deterministic planner and still runs.
GEMINI_API_KEY=
# Extra keys, comma-separated. The pool rotates across them and cools a key down on
# quota exhaustion instead of failing the request. Free-tier keys benefit most.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Tried in order after the primary model when it is unavailable or overloaded.
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_QUOTA_COOLDOWN_S=60
GEMINI_TEMPERATURE=0.0

# ---- orchestration ---------------------------------------------------------
ORCHESTRATOR_BACKEND=native
LYZR_API_KEY=

# ---- integrations ----------------------------------------------------------
# true = fully offline fixtures; no Zomato or Google account needed.
USE_MOCKS=true
ZOMATO_MCP_URL=https://mcp.zomato.com/mcp
ZOMATO_MCP_TOKEN=
CALENDAR_MCP_URL=
CALENDAR_MCP_TOKEN=
CATALOG_CACHE_TTL_S=300

# ---- money -----------------------------------------------------------------
PAYMENT_RAIL=mock
# How Zomato collects from you. `upi` sends a collect request to your UPI app (real
# money, real food, one approval); `cash_on_delivery` moves no money at order time.
ZOMATO_SETTLEMENT_TYPE=upi
# Whether the agent ALSO debits its own payment rail. Off for ordinary Zomato orders --
# Zomato is the merchant and collects from you directly, so the agent moves no money.
AGENT_DEBITS_RAIL=false
MAX_PER_ORDER_INR=1000
DAILY_CAP_INR=1500
MONTHLY_CAP_INR=20000
HUMAN_APPROVAL_ABOVE_INR=800
# Restaurants rated below this are never considered, however well they otherwise score.
MIN_RESTAURANT_RATING=3.8
# A dish must clear this to count as "the thing you asked for". A 4.5-star restaurant
# can still serve one badly-reviewed biryani.
MIN_DISH_RATING=3.5
# If the dish you asked for is not available at acceptable quality, order something else
# anyway? Off by default: you asked for biryani, so quietly sending idli is not an answer.
AUTO_SUBSTITUTE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MANDATE_MAX_AMOUNT_INR=5000

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
SKYFIRE_API_KEY=

# ---- memory / server -------------------------------------------------------
MEMORY_PATH=var/memory
PORT=10000

# ---- dashboard auth --------------------------------------------------------
# Unset APP_PASSWORD runs the UI open. Fine locally; the service refuses to start
# in ENVIRONMENT=prod without it.
APP_PASSWORD=
# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Protects /webhook/schedule-tick so only your scheduler can trigger paid orders.
WEBHOOK_SHARED_SECRET=

# ---- rate limits (per client IP, per minute) -------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_RUN_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=8
# Trust X-Forwarded-For for client identity. Enable ONLY behind a proxy that sets it
# (Render does). Enabled without one, anyone can rotate the header to bypass rate limits.
TRUST_PROXY=false
# Largest accepted request body, in bytes. Every endpoint takes a small JSON object.
MAX_REQUEST_BYTES=65536
